# Factory CSI environment template.
# Copy to .env (git-ignored) and fill in your key:  cp .env.example .env
# A real key belongs ONLY in .env. Never commit it.
# Without a valid key the app still runs: overview and statistics work,
# AI investigation is disabled, and there is no fallback or demo output.

# ---------------------------------------------------------------------------
# LLM (via LiteLLM). LLM_MODEL is a LiteLLM model string; its provider prefix
# ("deepseek/", "openai/", "gemini/", ...) selects the provider. If LLM_MODEL
# has no prefix, LLM_PROVIDER is used as the prefix.
# ---------------------------------------------------------------------------
# Provider name used as model prefix when LLM_MODEL has none (e.g. deepseek, openai, gemini, dashscope, openrouter, ollama)
LLM_PROVIDER=deepseek
# LiteLLM model string
LLM_MODEL=deepseek/deepseek-flash
# API key of the provider (empty = investigation disabled; not needed for ollama)
LLM_API_KEY=
# Optional custom endpoint (empty = provider default)
LLM_BASE_URL=
# Thinking/reasoning mode: true or false (false is faster and cheaper)
LLM_THINKING=false
# Per-request timeout in seconds
LLM_TIMEOUT_S=60

# --- Provider examples (uncomment one block) --------------------------------
# DeepSeek (key required)
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek/deepseek-flash
# LLM_API_KEY=<your-api-key>
#
# OpenAI (key required)
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_API_KEY=<your-api-key>
#
# Google Gemini (key required)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_API_KEY=<your-api-key>
#
# Qwen via DashScope, OpenAI-compatible mode (key required)
# LLM_PROVIDER=dashscope
# LLM_MODEL=dashscope/qwen-plus
# LLM_API_KEY=<your-api-key>
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# OpenRouter (key required)
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/deepseek/deepseek-chat
# LLM_API_KEY=<your-api-key>
#
# Ollama, local model (no key). Local dev: http://localhost:11434
# Inside Docker Compose use http://host.docker.internal:11434
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/qwen3:8b
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
# Directory with generated datasets data/ds-00..ds-03
DATA_DIR=./data
# Application database (cases, events, evidence, reports)
APP_DB_PATH=./var/app.db
# LangGraph checkpoint database
CHECKPOINT_DB_PATH=./var/checkpoints.db
# Logs (MCP call logs, hook logs)
LOG_DIR=./logs
# Comma-separated allowed browser origins (no "*")
CORS_ORIGINS=http://localhost:5173
# Bind address: 127.0.0.1 locally, 0.0.0.0 inside Docker
HOST=127.0.0.1
# Backend port
PORT=8000
# Docker Compose only: host port of the web UI (http://localhost:<port>)
CSI_WEB_PORT=18473
