# Secrets – a real key belongs only in .env
.env
.env.*
!.env.example

# Generated data and runtime state (anchored to repo root)
/data/
/var/
/logs/

# Evaluation raw results (keep the latest summary)
evaluation/results/*
!evaluation/results/latest-summary.json
!evaluation/results/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/

# Frontend
node_modules/
dist/
frontend/coverage/

# OS / editor
.DS_Store
